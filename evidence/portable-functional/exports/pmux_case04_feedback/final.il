    parameter signed \T_FALL_MAX 0
    parameter \SRC_WIDTH 1
    parameter \SRC_DST_POL 1'0
    parameter \SRC_DST_PEN 1'0
    parameter \FULL 1'0
    parameter \DST_WIDTH 1
    connect \SRC \I
    connect \EN 1'1
    connect \DST \O
  end
end
