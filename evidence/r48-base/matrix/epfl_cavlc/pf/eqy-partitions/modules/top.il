  connect { \trailingones[1] \trailingones[0] \totalcoeffs[4] \totalcoeffs[3] \totalcoeffs[2] \totalcoeffs[1] \totalcoeffs[0] \ctable[2] \ctable[1] \ctable[0] } { \__pi_trailingones[1] \__pi_trailingones[0] \__pi_totalcoeffs[4] \__pi_totalcoeffs[3] \__pi_totalcoeffs[2] \__pi_totalcoeffs[1] \__pi_totalcoeffs[0] \__pi_ctable[2] \__pi_ctable[1] \__pi_ctable[0] }
  connect { \__po_ctoken_len[4] \__po_ctoken_len[3] \__po_ctoken_len[2] \__po_ctoken_len[1] \__po_ctoken_len[0] \__po_coeff_token[5] \__po_coeff_token[4] \__po_coeff_token[3] \__po_coeff_token[2] \__po_coeff_token[1] \__po_coeff_token[0] } { \ctoken_len[4] \ctoken_len[3] \ctoken_len[2] \ctoken_len[1] \ctoken_len[0] \coeff_token[5] \coeff_token[4] \coeff_token[3] \coeff_token[2] \coeff_token[1] \coeff_token[0] }
end
