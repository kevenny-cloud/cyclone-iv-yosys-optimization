verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../partitions/top.cOut.sv
read_rtlil ../../../partitions/top.cOut.il
hierarchy -top miter; proc; chformal -cover -remove
async2sync
formalff -clk2ff -ff2anyinit gate.top.cOut
setundef -anyseq gate.top.cOut
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
sat -tempinduct -set-init-undef -set-def-formal -set-def-inputs -maxsteps 30 -timeout 90 -set-assumes -prove-asserts -show-public -dump_vcd trace.vcd miter
