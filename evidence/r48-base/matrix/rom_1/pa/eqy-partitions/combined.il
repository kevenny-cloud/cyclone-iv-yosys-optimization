  cell $assert $auto$miter.cc:273:create_miter_equiv$1332
    connect \A $auto$miter.cc:228:create_miter_equiv$1331
    connect \EN 1'1
  end
  cell $not $auto$miter.cc:281:create_miter_equiv$1333
    parameter \A_WIDTH 1
    parameter \Y_WIDTH 1
    parameter \A_SIGNED 0
    connect \A $auto$miter.cc:228:create_miter_equiv$1331
    connect \Y \trigger
  end
end
